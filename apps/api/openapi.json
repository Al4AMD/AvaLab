{
  "components": {
    "schemas": {
      "Body_ingest_api_v1_ingest_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_ingest_api_v1_ingest_post",
        "type": "object"
      },
      "CancelResponse": {
        "description": "Cancellation result; false means the job had already finished.",
        "properties": {
          "cancelled": {
            "title": "Cancelled",
            "type": "boolean"
          }
        },
        "required": [
          "cancelled"
        ],
        "title": "CancelResponse",
        "type": "object"
      },
      "CodecEncodeRequest": {
        "description": "Reference to a stored canonical excerpt and the requested codec.",
        "properties": {
          "audio_id": {
            "title": "Audio Id",
            "type": "string"
          },
          "codec": {
            "enum": [
              "wav",
              "flac",
              "mp3",
              "aac",
              "opus",
              "vorbis"
            ],
            "title": "Codec",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/CodecParams"
          }
        },
        "required": [
          "audio_id",
          "codec"
        ],
        "title": "CodecEncodeRequest",
        "type": "object"
      },
      "CodecEncodeResponse": {
        "description": "Encoded size, aligned reference window and quality metadata.",
        "properties": {
          "aligned_sample_count": {
            "title": "Aligned Sample Count",
            "type": "integer"
          },
          "bit_exact": {
            "title": "Bit Exact",
            "type": "boolean"
          },
          "bitrate_kbps": {
            "title": "Bitrate Kbps",
            "type": "number"
          },
          "codec_delay_samples": {
            "title": "Codec Delay Samples",
            "type": "integer"
          },
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "encode_ms": {
            "title": "Encode Ms",
            "type": "number"
          },
          "lossless": {
            "title": "Lossless",
            "type": "boolean"
          },
          "reference_start_sample": {
            "title": "Reference Start Sample",
            "type": "integer"
          },
          "result_audio_id": {
            "title": "Result Audio Id",
            "type": "string"
          },
          "sample_rate_hz": {
            "title": "Sample Rate Hz",
            "type": "integer"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "result_audio_id",
          "size_bytes",
          "bitrate_kbps",
          "encode_ms",
          "codec_delay_samples",
          "reference_start_sample",
          "aligned_sample_count",
          "duration_s",
          "sample_rate_hz",
          "bit_exact",
          "lossless"
        ],
        "title": "CodecEncodeResponse",
        "type": "object"
      },
      "CodecParams": {
        "description": "Optional codec-specific quality controls; validated per codec.",
        "properties": {
          "bitrate_kbps": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bitrate Kbps"
          },
          "compression_level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compression Level"
          },
          "quality": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality"
          }
        },
        "title": "CodecParams",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Nested error payload: stable machine-readable code plus developer message.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The shared error envelope every non-2xx JSON body uses.\n\nReferenced from each route's ``responses={...}`` declaration so the\nOpenAPI document (and the generated TypeScript client) match the runtime\nshape instead of FastAPI's HTTPValidationError default.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health payload: service status, API version, ffmpeg and codec availability.",
        "properties": {
          "codecs": {
            "items": {
              "type": "string"
            },
            "title": "Codecs",
            "type": "array"
          },
          "ffmpeg": {
            "title": "Ffmpeg",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "ffmpeg",
          "codecs"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IngestResponse": {
        "description": "Canonical audio handle returned by a successful ingest.",
        "properties": {
          "audio_id": {
            "title": "Audio Id",
            "type": "string"
          },
          "channels": {
            "title": "Channels",
            "type": "integer"
          },
          "duration_s": {
            "title": "Duration S",
            "type": "number"
          },
          "sample_rate_hz": {
            "title": "Sample Rate Hz",
            "type": "integer"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "audio_id",
          "duration_s",
          "sample_rate_hz",
          "channels",
          "size_bytes"
        ],
        "title": "IngestResponse",
        "type": "object"
      },
      "MlJobRequest": {
        "description": "Reference to stored audio plus task-specific parameters.",
        "properties": {
          "audio_id": {
            "title": "Audio Id",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "audio_id"
        ],
        "title": "MlJobRequest",
        "type": "object"
      },
      "MlJobResponse": {
        "description": "Accepted job reference.",
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "MlJobResponse",
        "type": "object"
      },
      "ModelInfo": {
        "description": "One model row rendered by the AI lab model-status banner.",
        "properties": {
          "license": {
            "title": "License",
            "type": "string"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "state": {
            "enum": [
              "available",
              "missing",
              "loading",
              "error"
            ],
            "title": "State",
            "type": "string"
          },
          "task": {
            "enum": [
              "denoise",
              "superres",
              "separation",
              "asr",
              "neural_codec"
            ],
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "task",
          "model_id",
          "revision",
          "license",
          "size_bytes",
          "state"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "ModelsResponse": {
        "description": "All five fixed tasks, in stable order, plus the global ML switch.",
        "properties": {
          "ml_enabled": {
            "title": "Ml Enabled",
            "type": "boolean"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "ml_enabled",
          "models"
        ],
        "title": "ModelsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AvaLab API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/audio/{audio_id}": {
      "delete": {
        "description": "Delete the stored object; 204 on success, 404 when it does not exist.",
        "operationId": "delete_audio_api_v1_audio__audio_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "audio_id",
            "required": true,
            "schema": {
              "title": "Audio Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown audio id (not_found)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Audio"
      },
      "get": {
        "description": "Stream the canonical WAV: 200 full, 206 for a valid Range request.\n\nRange edge semantics are documented at module level; multi-range requests\nare served as ``multipart/byteranges`` by FileResponse.",
        "operationId": "get_audio_api_v1_audio__audio_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "audio_id",
            "required": true,
            "schema": {
              "title": "Audio Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Range",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Range"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed, oversized or too many Range specs (invalid_request)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown audio id (not_found)"
          },
          "416": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requested range is not satisfiable (range_not_satisfiable)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Audio"
      }
    },
    "/codec/encode": {
      "post": {
        "description": "Encode, decode, align and store one excerpt with the requested codec.",
        "operationId": "encode_codec_api_v1_codec_encode_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodecEncodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodecEncodeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed request body (invalid_request)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown audio id or corrupt metadata (not_found)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid codec/params, unavailable encoder or encode failure (invalid_request, codec_unavailable, encode_failed)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal storage failure (internal_error)"
          }
        },
        "summary": "Encode Codec"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ingest": {
      "post": {
        "description": "Accept one uploaded audio file and store its normalized canonical form.",
        "operationId": "ingest_api_v1_ingest_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_api_v1_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed request body (invalid_request)"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Upload exceeds the size cap (file_too_large)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Decode failure, duration above the cap, or request validation error (decode_failed, duration_too_long, invalid_request)"
          }
        },
        "summary": "Ingest"
      }
    },
    "/jobs/{job_id}": {
      "delete": {
        "description": "Cancel a queued or running job; unknown ids are 404.",
        "operationId": "cancel_job_api_v1_jobs__job_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Job"
      }
    },
    "/jobs/{job_id}/events": {
      "get": {
        "description": "Stream one snapshot, progress updates, then a terminal event.",
        "operationId": "job_events_api_v1_jobs__job_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Job Events"
      }
    },
    "/ml/{task}": {
      "post": {
        "description": "Validate the excerpt/model and queue the task.",
        "operationId": "start_job_api_v1_ml__task__post",
        "parameters": [
          {
            "in": "path",
            "name": "task",
            "required": true,
            "schema": {
              "enum": [
                "denoise",
                "superres",
                "separation",
                "asr",
                "neural_codec"
              ],
              "title": "Task",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MlJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MlJobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Job"
      }
    },
    "/models": {
      "get": {
        "description": "Report local availability without importing any ML backend.",
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models"
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
