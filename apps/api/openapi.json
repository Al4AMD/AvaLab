  "info": {
    "title": "AvaLab API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/audio/{audio_id}": {
      "delete": {
        "description": "Delete the stored object; 204 on success, 404 when it does not exist.",
        "operationId": "delete_audio_api_v1_audio__audio_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "audio_id",
            "required": true,
            "schema": {
              "title": "Audio Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown audio id (not_found)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Audio"
      },
      "get": {
        "description": "Stream the canonical WAV: 200 full, 206 for a valid Range request.\n\nRange edge semantics are documented at module level; multi-range requests\nare served as ``multipart/byteranges`` by FileResponse.",
        "operationId": "get_audio_api_v1_audio__audio_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "audio_id",
            "required": true,
            "schema": {
              "title": "Audio Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Range",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Range"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed, oversized or too many Range specs (invalid_request)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown audio id (not_found)"
          },
          "416": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requested range is not satisfiable (range_not_satisfiable)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Audio"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ingest": {
      "post": {
        "description": "Accept one uploaded audio file and store its normalized canonical form.",
        "operationId": "ingest_api_v1_ingest_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_api_v1_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Malformed request body (invalid_request)"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Upload exceeds the size cap (file_too_large)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Decode failure, duration above the cap, or request validation error (decode_failed, duration_too_long, invalid_request)"
          }
        },
        "summary": "Ingest"
      }
    }
