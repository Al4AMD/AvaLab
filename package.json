{
  "name": "avalab",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm i18n:check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test \"scripts/**/*.test.mjs\"",
    "i18n:check": "node scripts/i18n-check.mjs",
    "e2e": "pnpm --filter @avalab/web e2e",
    "gen:golden": "uv run --directory tools/golden python -m avalab_golden generate",
    "gen:api": "node scripts/gen-api.mjs",
    "dev:web": "pnpm --filter @avalab/web dev",
    "dev:api": "uv run --directory apps/api uvicorn avalab_api.main:app --reload",
    "test:api": "uv run --directory apps/api pytest -q"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
