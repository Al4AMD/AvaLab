# AvaLab API configuration (apps/api). Copy this file to .env and adjust as needed.
# Every variable uses the AVALAB_ prefix (pydantic-settings; see apps/api/src/avalab_api/config.py).
# The real .env file is git-ignored and never committed.

# Maximum accepted upload size in bytes (default: 100 MB).
AVALAB_MAX_UPLOAD_BYTES=104857600

# Maximum accepted audio duration in seconds (default: 5 minutes). Longer files are rejected.
AVALAB_MAX_DURATION_SECONDS=300

# Maximum accepted sample rate in Hz. Higher rates are resampled down on ingest.
AVALAB_MAX_SAMPLE_RATE_HZ=96000

# Maximum number of channels kept. More channels are downmixed on ingest.
AVALAB_MAX_CHANNELS=2

# Minutes before an uploaded/derived audio file is auto-deleted.
AVALAB_TTL_MINUTES=60

# Seconds between TTL sweep runs that delete expired audio.
AVALAB_TTL_SWEEP_INTERVAL_SECONDS=60

# Directory for temporary audio storage (relative to the API working directory; in Docker: /data).
AVALAB_STORAGE_DIR=storage

# Allowed CORS origins as a JSON array. Empty list = no cross-origin access.
AVALAB_CORS_ORIGINS=[]
