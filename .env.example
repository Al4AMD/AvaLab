# AvaLab configuration. Copy this file to .env and adjust as needed.
# API variables use the AVALAB_ prefix (pydantic-settings; see apps/api/src/avalab_api/config.py).
# The real .env file is git-ignored and never committed.

# Host port for the web container (Docker Compose only). Default: 8080.
AVALAB_HTTP_PORT=8080

# Maximum accepted upload size in bytes (default: 200 MB).
AVALAB_MAX_UPLOAD_BYTES=209715200

# Maximum accepted audio duration in seconds (default: 5 minutes). Longer files are rejected.
AVALAB_MAX_DURATION_SECONDS=300

# Maximum accepted sample rate in Hz. Higher rates are resampled down on ingest.
AVALAB_MAX_SAMPLE_RATE_HZ=96000

# Maximum number of channels kept. More channels are downmixed on ingest.
AVALAB_MAX_CHANNELS=2

# Minutes before an uploaded/derived audio file is auto-deleted.
AVALAB_TTL_MINUTES=60

# Seconds between TTL sweep runs that delete expired audio.
AVALAB_TTL_SWEEP_INTERVAL_SECONDS=60

# Directory for temporary audio storage (relative to the API working directory; in Docker: /data).
AVALAB_STORAGE_DIR=storage

# Enable backend ML tools. Set false for a browser-only deployment.
AVALAB_ML_ENABLED=true

# Maximum concurrent ML jobs. CPU deployments should keep this at 1.
AVALAB_ML_MAX_CONCURRENCY=1

# Longest audio excerpt accepted by a single ML job, in seconds.
AVALAB_ML_MAX_EXCERPT_SECONDS=30

# ML device: cpu (default) or cuda. cuda moves ASR, separation and Encodec to
# CUDA; super-resolution uses CUDA only when the ONNX runtime provides it and
# denoise stays CPU. Requires an owner-built CUDA image; untested.
AVALAB_ML_DEVICE=cpu

# Model cache directory. Local default: ~/.cache/avalab/models.
# Docker Compose sets this to /models; uncomment only for a custom local path.
# AVALAB_ML_MODEL_CACHE_DIR=/models

# Allowed CORS origins as a JSON array. Empty list = same-origin only.
AVALAB_CORS_ORIGINS=[]

# One browser origin to append to the CORS allow-list. Empty = disabled.
# Must be scheme://host[:port]; scheme/host are lowercased and the default port
# and any trailing slash are removed.
# Safe example: AVALAB_PUBLIC_ORIGIN=https://avalab.example.edu
AVALAB_PUBLIC_ORIGIN=

# The Docker API runs with HuggingFace/Transformers offline by default.
# Use the prefetch commands in docs/DEPLOYMENT.md to populate the model cache once.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
